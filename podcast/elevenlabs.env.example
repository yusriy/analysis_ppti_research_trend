# Copy this file to ../../.secrets/elevenlabs.env and replace the placeholders.
# Never commit the completed credentials file.
ELEVENLABS_API_KEY=replace_with_your_api_key
ELEVENLABS_VOICE_ID=replace_with_your_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_SPEED=0.98
